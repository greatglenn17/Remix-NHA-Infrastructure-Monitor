rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isWriter() {
      return request.auth != null && request.auth.token.get('role', '') != 'VIEWER';
    }

    // The project's assignedUids list lives in Firestore. A missing project makes
    // get() fail, which denies.
    function inProject(projectUuid) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/projects/$(projectUuid)).data.assignedUids;
    }

    // Photos and scans attached to records, one file per attachment:
    //   attachments/{projectUuid}/{fileId}.jpg|.pdf  (see Attachments.kt)
    match /attachments/{projectUuid}/{fileName} {
      allow read: if isSuperAdmin() || inProject(projectUuid);
      allow create, update: if (isSuperAdmin() || (isWriter() && inProject(projectUuid)))
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if isSuperAdmin() || (isWriter() && inProject(projectUuid));
    }

    // Old 1.4.x path without a project: Super Admin only.
    match /attachments/{fileName} {
      allow read, write: if isSuperAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
