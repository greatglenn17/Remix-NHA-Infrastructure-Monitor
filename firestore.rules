rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administrative roles are Firebase custom claims. They must only be set
    // by a trusted Admin SDK environment, never by a mobile client.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isAssigned(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.assignedUid == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, create, update, delete: if signedIn();

      match /{subcollection}/{documentId} {
        allow read: if isSuperAdmin() || isAssigned(projectId);
        allow create, update: if isSuperAdmin() || isAssigned(projectId);
        allow delete: if isSuperAdmin();
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isSuperAdmin();

      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
