rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administrative roles are Firebase custom claims. They must only be set
    // by a trusted Admin SDK environment, never by a mobile client.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'SUPER_ADMIN';
    }

    // The Super Admin approved this account (the approved claim, from syncUserCustomClaims). An account
    // from before approvals has a role claim but no approved claim and stays approved; a brand-new
    // account has neither until the function runs, so it starts unapproved.
    function approved() {
      return signedIn() && request.auth.token.get('approved', request.auth.token.get('role', '') != '') == true;
    }

    // Signed in, approved, and not a read-only Viewer or Super Viewer.
    function isWriter() {
      return approved() && !(request.auth.token.get('role', '') in ['VIEWER', 'SUPER_VIEWER']);
    }

    // Reads every project: the Super Admin, a Super Viewer, and anyone the Super Admin
    // switched "See all projects" on for (the allProjects claim). Writing still needs
    // the project to be assigned to them.
    function seesAll() {
      return isSuperAdmin()
        || (signedIn() && (request.auth.token.get('role', '') == 'SUPER_VIEWER'
                           || request.auth.token.get('allProjects', false) == true));
    }

    function assigned(uids) {
      return signedIn() && request.auth.uid in uids;
    }

    function isAssigned(projectId) {
      return assigned(get(/databases/$(database)/documents/projects/$(projectId)).data.assignedUids);
    }

    function recordShape(recordId) {
      return signedIn()
        && request.resource.data.uuid == recordId
        && request.resource.data.projectUuid is string
        && request.resource.data.revision is int;
    }

    // The writer is assigned to the record's project and the record's copy of the list
    // matches the project's list exactly. A missing project makes get() fail, which denies.
    function recordInAssignedProject() {
      let project = get(/databases/$(database)/documents/projects/$(request.resource.data.projectUuid)).data;
      return isWriter()
        && assigned(project.assignedUids)
        && request.resource.data.assignedUids == project.assignedUids;
    }

    match /projects/{projectId} {
      allow read: if seesAll() || assigned(resource.data.assignedUids);
      // The creator is assigned automatically and cannot add anyone else.
      allow create: if isSuperAdmin()
        || (isWriter()
            && request.resource.data.assignedUids.size() == 1
            && request.auth.uid in request.resource.data.assignedUids);
      // The approved bar chart (the target % follows it) is the Super Admin's or an assigned Engineer Admin's to change.
      allow update: if isSuperAdmin()
        || (isWriter()
            && assigned(resource.data.assignedUids)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedUids'])
            && (request.auth.token.get('role', '') == 'ENGINEER_ADMIN'
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['barChartJson'])));
      // Deletion is the isDeleted tombstone, never a physical delete.
      allow delete: if false;

      match /{subcollection}/{documentId} {
        allow read: if seesAll() || isAssigned(projectId);
        allow create, update: if isSuperAdmin() || (isWriter() && isAssigned(projectId));
        allow delete: if isSuperAdmin();
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      // syncUserCustomClaims mints the role and allProjects claims from this doc's role and
      // seesAllProjects, so only the Super Admin changes them. A new profile starts as Field Engineer or Viewer;
      // SUPER_ADMIN only for the designated super admin account.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('seesAllProjects', false) == false
        && request.resource.data.get('approved', false) == false
        && (request.resource.data.get('role', 'FIELD_ENGINEER') in ['FIELD_ENGINEER', 'VIEWER']
            || (request.resource.data.get('role', '') == 'SUPER_ADMIN'
                && request.auth.token.email == 'great.glenn17@gmail.com'
                && request.auth.token.email_verified == true));
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'seesAllProjects', 'approved']);
      allow update: if isSuperAdmin() && request.auth.uid != userId
        && request.resource.data.get('role', '') in ['ENGINEER_ADMIN', 'FIELD_ENGINEER', 'VIEWER', 'SUPER_VIEWER']
        && request.resource.data.get('seesAllProjects', false) is bool
        && request.resource.data.get('approved', false) is bool;
      allow delete: if isSuperAdmin();

      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Weekly/monthly reports, documents, issues and payments, one document per record.
    // Each record carries a copy of its project's assignedUids. Records are never deleted,
    // only marked isDeleted, so other phones learn about the deletion.
    match /records/{recordId} {
      allow read: if seesAll() || assigned(resource.data.assignedUids);
      allow create: if recordShape(recordId) && (isSuperAdmin() || recordInAssignedProject());
      allow update: if recordShape(recordId)
        && (isSuperAdmin() || (assigned(resource.data.assignedUids) && recordInAssignedProject()));
      allow delete: if false;
    }

    // Nothing writes this collection (the app syncs its audit log as records), so it is closed:
    // no one can add fake entries.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
