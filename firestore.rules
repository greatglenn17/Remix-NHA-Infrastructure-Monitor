rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administrative roles are Firebase custom claims. They must only be set
    // by a trusted Admin SDK environment, never by a mobile client.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isAssigned(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.assignedUid == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, create, update, delete: if signedIn();

      match /{subcollection}/{documentId} {
        allow read: if isSuperAdmin() || isAssigned(projectId);
        allow create, update: if isSuperAdmin() || isAssigned(projectId);
        allow delete: if isSuperAdmin();
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      // A profile may only claim SUPER_ADMIN for the designated super admin account.
      allow create, update: if signedIn() && request.auth.uid == userId
        && (request.resource.data.get('role', '') != 'SUPER_ADMIN'
            || request.auth.token.email == 'great.glenn17@gmail.com');
      allow delete: if isSuperAdmin();

      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Weekly/monthly reports, documents, issues and payments, one document per record.
    // Same access as project profiles: any signed-in user. Records are never deleted,
    // only marked isDeleted, so other phones learn about the deletion.
    match /records/{recordId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uuid == recordId
        && request.resource.data.projectUuid is string
        && request.resource.data.revision is int;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
